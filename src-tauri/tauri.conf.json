{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kite",
  "version": "0.1.0",
  "identifier": "io.github.rootsec1.kite",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Kite",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "resizable": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kite contributors",
    "homepage": "https://github.com/rootsec1/kite",
    "copyright": "Copyright © 2026 Kite contributors",
    "license": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Native Kubernetes cockpit",
    "longDescription": "Kite is a native, UI-first Kubernetes cockpit for inspecting, debugging, and operating local and remote Kubernetes clusters.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleName": "Kite",
      "bundleVersion": "1",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    }
  }
}
