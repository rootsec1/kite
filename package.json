{
  "name": "kite",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "A native, UI-first Kubernetes cockpit built with Tauri, Rust, and React.",
  "license": "Apache-2.0",
  "author": "Kite contributors",
  "homepage": "https://github.com/rootsec1/kite#readme",
  "bugs": {
    "url": "https://github.com/rootsec1/kite/issues"
  },
  "keywords": [
    "kubernetes",
    "tauri",
    "k8s",
    "desktop",
    "macos"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rootsec1/kite.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "bun run typecheck && bun run build:web",
    "build:web": "vite build",
    "mac:build": "tauri build --target universal-apple-darwin",
    "release:cask": "bun scripts/generate-homebrew-cask.mjs",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  }
}
